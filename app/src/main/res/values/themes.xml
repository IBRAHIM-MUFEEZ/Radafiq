<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme — inherits NoActionBar so the system action bar is suppressed.
        windowBackground is set to the app's dark base colour so the window
        background visible during long/scrolling screenshots (and behind any
        transparent Compose layers) matches the dark theme exactly.
        RadafiqTheme's SideEffect overrides this at runtime for light mode.
        Status bar and nav bar backgrounds are set transparent by
        enableEdgeToEdge() in MainActivity; the Compose layer handles colour.
    -->
    <style name="Theme.Radafiq" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
        Splash screen theme — uses the core-splashscreen compat library so the
        system draws an instant first frame while the app process starts.
        The splash auto-exits into Theme.Radafiq when installSplashScreen()
        signals readiness in MainActivity.
    -->
    <style name="Theme.Radafiq.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Radafiq</item>
    </style>
</resources>